# Pinned build inputs for mpv-builds. Human-readable record; keep in sync with
# .github/workflows/build.yml (the workflow currently reads these from its own env).
#
# We build mpv (the player app: mpv.app on macOS, mpv.exe on Windows, the binary on Linux)
# against an FFmpeg compiled from our fork (saindriches/FFmpeg): it carries the MMT/TLV demuxer
# (ARIB STD-B32) in-tree, so mpv plays Japanese ISDB-S3 4K/8K .mmts files natively. (Previously
# the feature was carried as patches/ffmpeg/*.patch on a release tarball; the fork branch
# supersedes them. mpv's own source patches still live in patches/mpv/.)
#
# The pinned branch is mmt-tlv-avsplus: mmt-tlv plus an AVS+ / AVS1-P16 "GuangDian" decoder
# (profile 0x48), the profile Chinese 1080i terrestrial broadcast uses and which upstream FFmpeg
# refuses to decode. Written against current master and ported back onto our base, where it is
# verified bit-identical to the author's own build across seven clips. mmt-tlv itself is left
# pristine, so dropping AVS+ is a one-line change back to its head.

FFMPEG_REPO=saindriches/FFmpeg                              # our FFmpeg fork (base: master @ 2025-12-02)
FFMPEG_REF=9e0c5c580006299e76cd465d7897af49205acc7f         # mmt-tlv-avsplus branch head; bump to re-sync
MPV_REF=master             # mpv git ref to build (master = nightly); pin a tag for a stable build
CACHE_EPOCH=1              # bump to force a full FFmpeg+mpv rebuild (busts the deps cache)
